{
  "name": "go",
  "displayName": "Go",
  "version": "1.0.0",
  "detect": { "files": ["go.mod"] },
  "rules": [
    { "pattern": "^go\\s+mod\\s+tidy\\b", "category": "dependencies", "metadata": { "tool": "go", "subcommand": "mod tidy" } },
    { "pattern": "^go\\s+mod\\s+download\\b", "category": "dependencies", "metadata": { "tool": "go", "subcommand": "mod download" } },
    { "pattern": "^go\\s+mod\\s+vendor\\b", "category": "dependencies", "metadata": { "tool": "go", "subcommand": "mod vendor" } },
    { "pattern": "^go\\s+install\\b", "category": "dependencies", "metadata": { "tool": "go", "subcommand": "install" } },
    { "pattern": "^go\\s+generate\\b", "category": "building", "metadata": { "tool": "go", "subcommand": "generate" } },
    { "pattern": "^go\\s+run\\b", "category": "running", "metadata": { "tool": "go", "subcommand": "run" } },
    { "pattern": "^air\\b", "category": "running", "metadata": { "tool": "air" } },
    { "pattern": "^go\\s+vet\\b", "category": "linting", "metadata": { "tool": "go", "subcommand": "vet" } },
    { "pattern": "^gofmt\\b", "category": "linting", "metadata": { "tool": "gofmt" } },
    { "pattern": "^goimports\\b", "category": "linting", "metadata": { "tool": "goimports" } },
    { "pattern": "^golangci-lint\\b", "category": "linting", "metadata": { "tool": "golangci-lint" } },
    { "pattern": "^staticcheck\\b", "category": "linting", "metadata": { "tool": "staticcheck" } },
    { "pattern": "^revive\\b", "category": "linting", "metadata": { "tool": "revive" } }
  ],
  "aiContext": "Go-specific context: 'go mod tidy' resolves and prunes dependencies. 'go generate' runs code generation (typically for mocks, protobufs, or embedded assets). 'go vet', 'golangci-lint', and 'staticcheck' are static analysis tools. 'air' is a hot-reload dev server for Go. 'gofmt'/'goimports' format code."
}
