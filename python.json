{
  "name": "python",
  "displayName": "Python",
  "version": "1.0.0",
  "detect": { "files": ["pyproject.toml"] },
  "rules": [
    { "pattern": "^pip3\\s+install\\b", "category": "dependencies", "metadata": { "tool": "pip3" } },
    { "pattern": "^python\\s+-m\\s+pip\\s+install\\b", "category": "dependencies", "metadata": { "tool": "pip" } },
    { "pattern": "^python3?\\s+-m\\s+pip\\s+install\\b", "category": "dependencies", "metadata": { "tool": "pip" } },
    { "pattern": "^conda\\s+install\\b", "category": "dependencies", "metadata": { "tool": "conda" } },
    { "pattern": "^conda\\s+create\\b", "category": "dependencies", "metadata": { "tool": "conda" } },
    { "pattern": "^conda\\s+update\\b", "category": "dependencies", "metadata": { "tool": "conda" } },
    { "pattern": "^poetry\\s+install\\b", "category": "dependencies", "metadata": { "tool": "poetry" } },
    { "pattern": "^poetry\\s+add\\b", "category": "dependencies", "metadata": { "tool": "poetry" } },
    { "pattern": "^poetry\\s+remove\\b", "category": "dependencies", "metadata": { "tool": "poetry" } },
    { "pattern": "^poetry\\s+update\\b", "category": "dependencies", "metadata": { "tool": "poetry" } },
    { "pattern": "^pipenv\\s+install\\b", "category": "dependencies", "metadata": { "tool": "pipenv" } },
    { "pattern": "^pipenv\\s+sync\\b", "category": "dependencies", "metadata": { "tool": "pipenv" } },
    { "pattern": "^python3?\\s+-m\\s+pytest\\b", "category": "testing", "metadata": { "tool": "pytest" } },
    { "pattern": "^tox\\b", "category": "testing", "metadata": { "tool": "tox" } },
    { "pattern": "^coverage\\s+run\\b", "category": "testing", "metadata": { "tool": "coverage" } },
    { "pattern": "^python3?\\s+manage\\.py\\s+migrate\\b", "category": "building", "metadata": { "subcommand": "migrate" } },
    { "pattern": "^python3?\\s+manage\\.py\\s+makemigrations\\b", "category": "building", "metadata": { "subcommand": "makemigrations" } },
    { "pattern": "^python3?\\s+manage\\.py\\s+collectstatic\\b", "category": "building", "metadata": { "subcommand": "collectstatic" } },
    { "pattern": "^alembic\\s+(upgrade|downgrade|revision|autogenerate)\\b", "category": "building", "metadata": { "tool": "alembic", "subcommand": "$1" } },
    { "pattern": "^poetry\\s+run\\b", "category": "running", "metadata": { "tool": "poetry" } },
    { "pattern": "^poetry\\s+shell\\b", "category": "running", "metadata": { "tool": "poetry" } },
    { "pattern": "^pipenv\\s+run\\b", "category": "running", "metadata": { "tool": "pipenv" } },
    { "pattern": "^uvicorn\\b", "category": "running", "metadata": { "tool": "uvicorn" } },
    { "pattern": "^gunicorn\\b", "category": "running", "metadata": { "tool": "gunicorn" } },
    { "pattern": "^celery\\s+worker\\b", "category": "running", "metadata": { "tool": "celery", "subcommand": "worker" } },
    { "pattern": "^celery\\s+beat\\b", "category": "running", "metadata": { "tool": "celery", "subcommand": "beat" } },
    { "pattern": "^flask\\s+run\\b", "category": "running", "metadata": { "tool": "flask" } },
    { "pattern": "^python3?\\s+manage\\.py\\s+shell\\b", "category": "running", "metadata": { "subcommand": "shell" } },
    { "pattern": "^python3?\\s+manage\\.py\\s+runserver\\b", "category": "running", "metadata": { "subcommand": "runserver" } },
    { "pattern": "^mypy\\b", "category": "linting", "metadata": { "tool": "mypy" } },
    { "pattern": "^black\\b", "category": "linting", "metadata": { "tool": "black" } },
    { "pattern": "^ruff\\b", "category": "linting", "metadata": { "tool": "ruff" } },
    { "pattern": "^flake8\\b", "category": "linting", "metadata": { "tool": "flake8" } },
    { "pattern": "^pylint\\b", "category": "linting", "metadata": { "tool": "pylint" } },
    { "pattern": "^isort\\b", "category": "linting", "metadata": { "tool": "isort" } },
    { "pattern": "^autopep8\\b", "category": "linting", "metadata": { "tool": "autopep8" } },
    { "pattern": "^bandit\\b", "category": "linting", "metadata": { "tool": "bandit" } },
    { "pattern": "^coverage\\s+report\\b", "category": "exploring", "metadata": { "tool": "coverage" } }
  ]
}
